{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Entekhab",
  "description": "__MSG_extDesc__",
  "version": "1.5.2",
  "default_locale": "fa",
  "homepage_url": "https://entekhab.net/extension/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://entekhab.net/*",
    "https://data-api.binance.vision/*"
  ],
  "omnibox": {
    "keyword": "ek"
  },
  "minimum_chrome_version": "116"
}
