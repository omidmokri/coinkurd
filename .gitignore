__pycache__/
*.pyc
tests/out/
/p/
/coins/
/sitemap.xml
/robots.txt
/api/
/academy/
/extension/

# Android signing keys must never be committed
*.p12
*.jks
*.keystore
ks_pass*

# painted backdrops are a local cache; they are re-made on demand and must never reach the repo
/data/art/

# the learning map is rebuilt from the academy on every run; it ships with the site, not the repo
/data/map.json

# the kids course is built by CI from content/b4j (see scripts/build_kids.py); never commit the output
/kids/
/library/          # built by scripts/build_pages.py, like /dossier/ and /learn/

# read-aloud voices and runtimes are fetched by CI (scripts/fetch_tts.py) and ship with the site,
# never with the repo: ~190 MB of binaries that would sit in git history forever
/tts/
/tts_check/
/dca/              # built by scripts/build_dca.py
/derivatives/      # built by scripts/build_derivatives.py
/leaderboard/      # built by scripts/build_leaderboard.py

# /app/ is built by scripts/build_apps.py
/app/index.html
